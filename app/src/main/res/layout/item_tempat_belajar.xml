<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    android:layout_margin="8dp"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Gradient -->
        <!-- Header Gradient -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/card_top_background"
            android:padding="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Nama tempat -->
            <TextView
                android:id="@+id/tvNamaTempat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📕 CW Coffe Malang"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:fontFamily="@font/archivo_bold"/>

            <!-- Spacer untuk mendorong tombol delete ke kanan -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <!-- Tombol delete -->
            <ImageView
                android:id="@+id/btnDelete"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_delete"
                android:contentDescription="Delete Icon"/>
        </LinearLayout>

        <!-- Bagian Bawah (Alamat) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvLabelAlamat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alamat:"
                android:textSize="14sp"
                android:textColor="#101828"
                android:textStyle="bold"
                android:fontFamily="@font/archivo_medium"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvAlamat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jl. Polisi Baik No. 87"
                android:layout_marginLeft="8dp"
                android:textSize="14sp"
                android:textColor="#667085"
                android:fontFamily="@font/archivo_regular"/>
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
