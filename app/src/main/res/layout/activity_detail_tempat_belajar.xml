<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="48dp"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:background="#ffffff"
    tools:context=".DetailTempatBelajarActivity">

    <!-- Button Back -->
    <FrameLayout
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/circle_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iconBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back Icon"/>
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/detail_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Detail Tempat Belajar"
        android:textSize="18sp"
        android:textColor="#101828"
        android:fontFamily="@font/archivo_medium"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Ikon Sertifikat / Checkmark -->
    <ImageView
        android:id="@+id/ix_certific"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:src="@drawable/ic_success"
        android:contentDescription="Checkmark Icon"
        android:scaleType="centerInside"
        android:clipToOutline="true"
        android:elevation="10dp"
        app:layout_constraintTop_toBottomOf="@id/detail_temp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"/>

    <!-- Container untuk ikon dan teks -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/containerText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:padding="12dp"
        android:background="@drawable/rounded_stroke"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ix_certific">

        <!-- Icon Coffee -->
        <ImageView
            android:id="@+id/iconUser"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_coffee"
            android:contentDescription="User Icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Teks utama (Halo, User 👋) -->
        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Halo, User 👋"
            android:textSize="16sp"
            android:textColor="#101828"
            android:fontFamily="@font/archivo_medium"
            app:layout_constraintStart_toEndOf="@id/iconUser"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="12dp"/>

        <!-- Teks deskripsi (Check ulang sebelum menyimpan data, ya!) -->
        <TextView
            android:id="@+id/tvSubtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Check ulang sebelum menyimpan data, ya!"
            android:textSize="14sp"
            android:textColor="#667085"
            android:fontFamily="@font/archivo_regular"
            app:layout_constraintStart_toStartOf="@id/tvGreeting"
            app:layout_constraintTop_toBottomOf="@id/tvGreeting"
            android:layout_marginTop="2dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tvNamaTempat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CW Coffe Malang"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#101828"
        android:fontFamily="@font/archivo_bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/containerText"
        android:layout_marginTop="32dp"/>

    <!-- Container untuk detail -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/containerDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="12dp"
        android:background="@drawable/rounded_stroke"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvNamaTempat">

        <!-- Preview Gambar -->
        <ImageView
            android:id="@+id/imagePreview"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:adjustViewBounds="true"
            android:background="@drawable/rounded_stroke"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTitleDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detail Tempat"
            android:textSize="16sp"
            android:textColor="#101828"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/archivo_medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imagePreview"/>

        <!-- Label "Alamat" -->
        <TextView
            android:id="@+id/tvLabelAlamat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alamat"
            android:textSize="14sp"
            android:textColor="#101828"
            android:fontFamily="@font/archivo_regular"
            app:layout_constraintStart_toStartOf="@id/tvTitleDetail"
            app:layout_constraintTop_toBottomOf="@id/tvTitleDetail"
            android:layout_marginTop="8dp"/>

        <!-- Value "Jl. Polisi Baik No. 87" -->
        <TextView
            android:id="@+id/tvAlamat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jl. Polisi Baik No. 87"
            android:textSize="14sp"
            android:textColor="#667085"
            android:fontFamily="@font/archivo_regular"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvLabelAlamat"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Button Simpan -->
    <Button
        android:id="@+id/button_simpan"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Simpan"
        android:layout_marginTop="32dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/archivo_medium"
        android:background="@drawable/button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/containerDetail"/>

</androidx.constraintlayout.widget.ConstraintLayout>