<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="12dp"
    android:elevation="4dp"
    android:background="@drawable/border_grey"
    android:clipToOutline="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/gradient_backgroud"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvMatkul"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/matkul_sample"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnDelete"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_delete"
            android:background="@android:color/transparent"
            android:contentDescription="Delete Icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="4dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="5dp"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvLabelHari"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hari Kuliah :"
            android:textSize="14sp"
            android:textColor="#101828"
            android:textStyle="bold"
            android:fontFamily="@font/archivo_medium"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvHari"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Senin"
            android:layout_marginLeft="3dp"
            android:textSize="14sp"
            android:textColor="#667085"
            android:fontFamily="@font/archivo_regular"/>
        <TextView
            android:id="@+id/tvLabelJam"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:text="Jam Kuliah :"
            android:textSize="14sp"
            android:textColor="#101828"
            android:textStyle="bold"
            android:fontFamily="@font/archivo_medium"
            android:layout_marginBottom="4dp"/>
            
        <TextView
            android:id="@+id/tvJam"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="13.00"
            android:layout_marginLeft="3dp"
            android:textSize="14sp"
            android:textColor="#667085"
            android:fontFamily="@font/archivo_regular"/>
    </LinearLayout>
</LinearLayout>
