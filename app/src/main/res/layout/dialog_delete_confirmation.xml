<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:padding="20dp"
    android:background="@drawable/rounded_background"
    android:gravity="center">

    <ImageView
        android:id="@+id/ivClose"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_close"
        android:layout_gravity="end"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/tvDeleteConfirmation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hapus item berikut?"
        android:textSize="18dp"
        android:fontFamily="@font/archivo_medium"
        android:textAllCaps="false"
        android:textColor="#101828"
        android:gravity="center"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/tvDeleteDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Item ini akan dihapus dari daftar \n pengeluaranmu."
        android:textSize="16dp"
        android:fontFamily="@font/archivo_regular"
        android:textAllCaps="false"
        android:textColor="#6D6E8C"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancel"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="Batal"
            android:fontFamily="@font/archivo_medium"
            android:textSize="14dp"
            android:textAllCaps="false"
            android:textColor="#101828"
            android:background="@drawable/button_border" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDelete"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="Hapus"
            android:fontFamily="@font/archivo_medium"
            android:textSize="14dp"
            android:textAllCaps="false"
            android:layout_marginLeft="14sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_red" />
    </LinearLayout>
</LinearLayout>
