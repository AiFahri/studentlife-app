<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="48dp"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:background="#ffffff"
    tools:context=".TambahTempatBelajarActivity">

    <!-- Button Back -->
    <FrameLayout
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/circle_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iconBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back Icon"/>
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/tambah_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tambah Tempat Belajar"
        android:textSize="18sp"
        android:textColor="#101828"
        android:fontFamily="@font/archivo_medium"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Container untuk ikon dan teks -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/containerText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="@drawable/rounded_stroke"
        android:layout_marginTop="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack">

        <!-- Icon Coffee -->
        <ImageView
            android:id="@+id/iconUser"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_coffee"
            android:contentDescription="User Icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Teks utama (Halo, User 👋) -->
        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Halo, User 👋"
            android:textSize="16sp"
            android:textColor="#101828"
            android:fontFamily="@font/archivo_medium"
            app:layout_constraintStart_toEndOf="@id/iconUser"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="12dp"/>

        <!-- Teks deskripsi (Tambahkan tempat belajar di bawah, ya!) -->
        <TextView
            android:id="@+id/tvSubtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tambahkan tempat belajar di bawah, ya!"
            android:textSize="14sp"
            android:textColor="#667085"
            android:fontFamily="@font/archivo_regular"
            app:layout_constraintStart_toStartOf="@id/tvGreeting"
            app:layout_constraintTop_toBottomOf="@id/tvGreeting"
            android:layout_marginTop="2dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Container untuk Form -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/containerForm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/containerText">

        <!-- Title: Nama Tempat -->
        <TextView
            android:id="@+id/nama_tempat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nama Tempat"
            android:textSize="14sp"
            android:textColor="#101828"
            android:fontFamily="@font/archivo_medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginBottom="8dp"/>

        <!-- Form Nama Tempat -->
        <RelativeLayout
            android:id="@+id/form_nama_tempat"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/form_normal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/nama_tempat">

            <!-- Icon di dalam Form -->
            <ImageView
                android:id="@+id/iconMap"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_map"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"/>

            <!-- EditText Nama Tempat -->
            <EditText
                android:id="@+id/etNamaTempat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toEndOf="@id/iconMap"
                android:hint="Masukkan nama tempat"
                android:textSize="14sp"
                android:textColor="#101828"
                android:textColorHint="#667085"
                android:background="@android:color/transparent"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>
        </RelativeLayout>

        <!-- Title: Alamat -->
        <TextView
            android:id="@+id/alamat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alamat"
            android:textSize="14sp"
            android:textColor="#101828"
            android:fontFamily="@font/archivo_medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/form_nama_tempat"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"/>

        <!-- Form Alamat -->
        <RelativeLayout
            android:id="@+id/form_alamat"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/form_normal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/alamat">

            <!-- Icon di dalam Form -->
            <ImageView
                android:id="@+id/iconLocation"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_location"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"/>

            <!-- EditText Alamat -->
            <EditText
                android:id="@+id/etAlamat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toEndOf="@id/iconLocation"
                android:hint="Masukkan alamat"
                android:textSize="14sp"
                android:textColor="#101828"
                android:textColorHint="#667085"
                android:background="@android:color/transparent"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>
        </RelativeLayout>

        <!-- Title: Unggah Foto -->
        <TextView
            android:id="@+id/label_upload_foto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unggah Foto"
            android:textSize="14sp"
            android:textColor="#101828"
            android:fontFamily="@font/archivo_medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/form_alamat"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <!-- Form Upload Foto -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/upload_foto_container"
            android:layout_width="match_parent"
            android:layout_height="102dp"
            android:background="@drawable/form_normal"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/label_upload_foto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/icon_upload"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_upload"
                android:contentDescription="Icon Upload"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/group_text"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginBottom="8dp" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/group_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/icon_upload"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tvUpload"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unggah file "
                    android:textSize="14sp"
                    android:textColor="#667085"
                    android:fontFamily="@font/archivo_regular"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <TextView
                    android:id="@+id/tvUploadUnderline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="disini"
                    android:textSize="14sp"
                    android:textColor="#101828"
                    android:textStyle="bold"
                    android:fontFamily="@font/archivo_medium"
                    app:layout_constraintStart_toEndOf="@id/tvUpload"
                    app:layout_constraintTop_toTopOf="@id/tvUpload"
                    app:layout_constraintBottom_toBottomOf="@id/tvUpload"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Button Pratinjau -->
    <Button
        android:id="@+id/button_pratinjau"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Pratinjau"
        android:layout_marginTop="32dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/archivo_medium"
        android:background="@drawable/button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/containerForm"/>
</androidx.constraintlayout.widget.ConstraintLayout>