<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_logo"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudentLife"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MenuActivity"
            android:exported="false" />
        <activity
            android:name=".DetailJadwalActivity"
            android:exported="false" />
        <activity
            android:name=".TambahJadwalActivity"
            android:exported="false" />
        <activity
            android:name=".ListJadwalActivity"
            android:exported="false">
        </activity>
        <activity
            android:name=".DetailTempatBelajarActivity"
            android:exported="false" />
        <activity
            android:name=".TambahTempatBelajarActivity"
            android:exported="false" />
        <activity
            android:name=".ListTempatBelajarActivity"
            android:exported="false">
        </activity>
        <activity
            android:name=".DetailPengeluaranActivity"
            android:exported="false"/>
        <activity
            android:name=".TambahPengeluaranActivity"
            android:exported="false"/>
        <activity
            android:name=".DaftarPengeluaranActivity"
            android:exported="false">
        </activity>
        <activity
            android:name=".TaskList"
            android:exported="false"
            android:label="@string/app_name">
        </activity>
        <activity android:name=".TaskAdd" />
        <activity android:name=".TaskPreview" />
    </application>

</manifest>